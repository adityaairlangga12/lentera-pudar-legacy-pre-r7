# ===================================================
# Lentera Pudar — .gitignore
# Engine: Unreal Engine 5 + Blender 5.2 LTS
# ===================================================

# --- Unreal Engine 5 ---
Saved/
Intermediate/
DerivedDataCache/
Binaries/
Build/
*.VC.db
*.VC.opendb
*.sln
*.vcxproj
*.vcxproj.filters
.vs/

# --- Blender ---
*.blend1
*.blend2
__pycache__/
*.pyc

# --- OS & Editor ---
.DS_Store
.vscode/
Thumbs.db
desktop.ini
.agents/mcp_config.local.json
.agents/hooks.local.json

# --- Future Git LFS candidates (policy deferred to R6) ---
# *.blend, *.fbx, *.gltf, *.wav, *.uasset sengaja tidak di-ignore karena dapat menjadi project assets; kebijakan tracking/LFS final belum ditetapkan.
